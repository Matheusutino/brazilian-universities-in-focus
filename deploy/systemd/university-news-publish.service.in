[Unit]
Description=Publish university-news data and rebuild the public website
After=postgresql.service university-news-postgres.service

[Service]
Type=oneshot
TimeoutStartSec=30min
WorkingDirectory=__PROJECT_ROOT__
EnvironmentFile=__PROJECT_ROOT__/.env
ExecStart=__UV__ run university-news-db export
# Refresh the published annotations; "-" tolerates an empty table.
ExecStart=-__UV__ run university-news-db export-enrichments
# Rebuild the public pages and search bundle from the fresh exports.
ExecStart=__UV__ run university-news-site build
