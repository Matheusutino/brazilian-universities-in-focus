[Unit]
Description=University news embedding worker
After=network-online.target postgresql.service university-news-postgres.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__PROJECT_ROOT__
EnvironmentFile=__PROJECT_ROOT__/.env
ExecStart=__UV__ run university-news-worker --stages embed
Restart=on-failure
RestartSec=20

[Install]
WantedBy=default.target
