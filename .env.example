OPENROUTER_API_KEY=
# Model identifier in the OpenRouter catalog, without the "openrouter/" prefix.
OPENROUTER_MODEL=openai/gpt-4o-mini

# OpenAI-compatible endpoint exposed by OpenWebUI for clipping enrichment.
# Keep the real key only in .env; this file is safe to commit.
ENRICHMENT_PROVIDER=openwebui
OPENWEBUI_URL=https://agents4gov.icmc.usp.br/
OPENWEBUI_API_KEY=
OPENWEBUI_MODEL=externo.revejo-qwen3.6-35b-a3b
OPENWEBUI_TEMPERATURE=0.2
OPENWEBUI_TIMEOUT_SECONDS=300
OPENWEBUI_MAX_RETRIES=3
OPENWEBUI_VALIDATION_ATTEMPTS=2
OPENWEBUI_ENRICHMENT_CALLS=3
OPENWEBUI_MAX_INPUT_CHARS=24000
# Soft switch supported by Qwen models served through OpenWebUI.
OPENWEBUI_DISABLE_THINKING=true
OPENWEBUI_JSON_MODE=true

# NVIDIA hosted NIM. Set ENRICHMENT_PROVIDER=nvidia_nim to use it.
# A self-hosted NIM URL such as http://localhost:8000 is also accepted.
NVIDIA_NIM_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_NIM_MODEL=
NVIDIA_NIM_TEMPERATURE=0.2
NVIDIA_NIM_TIMEOUT_SECONDS=300
NVIDIA_NIM_MAX_RETRIES=3
NVIDIA_NIM_VALIDATION_ATTEMPTS=2
# Long-context NIM models can fill the complete schema in one request.
NVIDIA_NIM_ENRICHMENT_CALLS=1
NVIDIA_NIM_MAX_INPUT_CHARS=120000
NVIDIA_NIM_MAX_OUTPUT_TOKENS=16384
# Recommended for structured extraction; avoids long reasoning traces.
NVIDIA_NIM_DISABLE_THINKING=true
NVIDIA_NIM_JSON_MODE=true

# Fully local semantic search with LanceDB and a GGUF embedding model.
LANCEDB_PATH=data/indexes/lancedb
LANCEDB_TABLE=university_articles
EMBEDDING_MODEL_REPO=Qwen/Qwen3-Embedding-0.6B-GGUF
EMBEDDING_MODEL_FILE=Qwen3-Embedding-0.6B-Q8_0.gguf
EMBEDDING_CONTEXT_LENGTH=32768
# Queries are short and do not need the document indexing context window.
EMBEDDING_QUERY_CONTEXT_LENGTH=1024
EMBEDDING_GPU_LAYERS=-1
# Optional path to an existing GGUF file; avoids downloading from Hugging Face.
# EMBEDDING_MODEL_PATH=/path/to/Qwen3-Embedding-0.6B-Q8_0.gguf
SEARCH_MODE=hybrid
