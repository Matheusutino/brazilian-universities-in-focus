# Only credentials belong here. Provider behavior lives in config/settings.toml.

# PostgreSQL DSN. scripts/setup_local_postgres.sh replaces this placeholder
# with a generated password.
DATABASE_URL=postgresql://university_news:change-me@127.0.0.1:5432/university_news

# Optional separate read-only role for the website; otherwise uses DATABASE_URL.
# SITE_DATABASE_URL=postgresql://university_news_site:password@127.0.0.1:5432/university_news

# Optional: throwaway database for integration tests. It is wiped by the tests.
# TEST_DATABASE_URL=postgresql://university_news:change-me@127.0.0.1:5432/university_news_test

# Enrichment providers. Use *_API_KEYS (comma-separated) to rotate several keys;
# each key gets its own requests_per_minute budget.
NVIDIA_API_KEY=
# NVIDIA_API_KEYS=key-one,key-two
OPENWEBUI_API_KEY=
# OPENWEBUI_API_KEYS=key-one,key-two

# Optional: LLM-based article extraction (--extractor llm or hybrid).
OPENROUTER_API_KEY=
